{
  "name": "broadcasting-script-helper",
  "version": "1.0.0",
  "private": true,
  "description": "초등학교 방송부 금요방송 대본 작성 도우미 (Cloudflare Workers + D1 + Gemini)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:init:local": "wrangler d1 execute broadcasting-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute broadcasting-db --remote --file=./schema.sql",
    "test": "node --test \"test/*.test.js\"",
    "check": "node --check src/index.js && wrangler deploy --dry-run --outdir dist",
    "deploy:emergency": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
